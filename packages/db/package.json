{
  "name": "@ledgerly/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "verify": "tsx --env-file=.env src/verify-seed.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
