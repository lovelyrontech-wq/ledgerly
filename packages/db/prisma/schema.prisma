// Ledgerly data model. See docs/architecture/ARCHITECTURE.md, section 4.
//
// To switch to Postgres: change provider to "postgresql" and DATABASE_URL to a
// postgres:// URL, then run `npm run db:migrate` to create a fresh migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  ownedFolders Folder[]           @relation("FolderOwner")
  permissions  FolderPermission[]
  batches      Batch[]
  auditEntries AuditLog[]

  @@map("users")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  /// "invoice" | "product"
  type      String
  ownerId   String
  createdAt DateTime @default(now())

  owner       User               @relation("FolderOwner", fields: [ownerId], references: [id])
  permissions FolderPermission[]
  records     LedgerRecord[]
  batches     Batch[]

  @@index([ownerId])
  @@map("folders")
}

/// Sharing. The owner has full access implicitly and is not listed here.
model FolderPermission {
  folderId  String
  userId    String
  /// "editor" | "viewer"
  role      String
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
  @@map("folder_permissions")
}

/// Named LedgerRecord because `Record` clashes with TypeScript's built-in Record<K, V> type.
model LedgerRecord {
  id         String   @id @default(cuid())
  folderId   String
  name       String
  /// Money as integer cents. Never store money as a float.
  valueCents Int
  currency   String
  status     String
  /// Type-specific fields: customer/issuedAt/dueAt for invoices, sku/stock/category for products.
  fields     Json
  /// Incremented on every write. Bulk apply only writes when the version still matches the preview.
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  batchItems BatchItem[]

  @@index([folderId])
  @@map("records")
}

model Batch {
  id             String    @id @default(cuid())
  folderId       String
  createdBy      String
  /// "pending" | "applied" | "undone" | "expired" | "cancelled"
  status         String    @default("pending")
  /// The user's request in their own words, e.g. "update the values in this folder by 10%".
  instruction    String
  /// Set when the batch is applied. Repeating an apply with the same key returns the stored result.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  appliedAt      DateTime?
  undoneAt       DateTime?

  folder       Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  creator      User        @relation(fields: [createdBy], references: [id])
  items        BatchItem[]
  auditEntries AuditLog[]

  @@index([folderId, status])
  @@map("batches")
}

/// One record's change inside a batch: exact record ID, old value, new value, and the version it was previewed at.
model BatchItem {
  id              String  @id @default(cuid())
  batchId         String
  recordId        String
  field           String  @default("valueCents")
  before          Int
  after           Int
  expectedVersion Int
  /// null while pending; then "applied" | "skipped_changed" | "failed" | "undone" | "undo_skipped"
  result          String?
  error           String?

  batch  Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  record LedgerRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([batchId, recordId])
  @@index([recordId])
  @@map("batch_items")
}

/// Append-only. Rows are never updated or deleted by the app.
model AuditLog {
  id      String   @id @default(cuid())
  userId  String
  /// e.g. "batch.preview", "batch.apply", "batch.undo", "record.update"
  action  String
  batchId String?
  details Json
  at      DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([userId, at])
  @@map("audit_log")
}
