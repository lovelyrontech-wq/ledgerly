# Database (SQLite file, relative to packages/db/prisma/)
DATABASE_URL="file:./dev.db"

# Password given to every demo user (alice, bob, carol) when seeding. At least 8 characters.
SEED_DEMO_PASSWORD=change-me-please

# Ollama (step 5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# LangSmith (step 7)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerly-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
