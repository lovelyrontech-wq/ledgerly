# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# Database. Default is a SQLite file at backend/dev.db.
# For Postgres: postgresql+psycopg://user:pass@localhost:5432/ledgerly (and add the psycopg package).
DATABASE_URL=sqlite:///dev.db

# Password given to every demo user (alice, bob, carol) when seeding. At least 8 characters.
SEED_DEMO_PASSWORD=change-me-please

OLLAMA_TIMEOUT_SECONDS=300

AUTH_SECRET=

# Ollama (step 5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# LangSmith (step 7)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerly-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Minutes a bulk-update preview stays approvable
BATCH_PREVIEW_TTL_MINUTES=15
# MCP server (step 4)
API_PUBLIC_URL=http://localhost:8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PUBLIC_URL=http://localhost:8001/mcp

# Agent (step 5)
AGENT_ENGINE=plain
AGENT_ENGINES_ENABLED=plain
AGENT_MAX_STEPS=6
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192